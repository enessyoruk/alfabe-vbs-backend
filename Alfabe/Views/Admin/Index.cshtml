@model IEnumerable<Alfabe.Models.AppUser>
@{
    ViewData["Title"] = "Yöneticiler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Yönetici Listesi</h2>
        <a asp-action="CreateUser" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> Yeni Yönetici Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-hover table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>Kullanıcı Adı</th>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th style="width:220px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.AdSoyad</td>
                        <td>@user.Email</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-info btn-sm me-1">
                                <i class="fas fa-eye"></i> Detay
                            </a>

                            @if (user.Id == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                            {
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>
                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash-alt"></i> Sil
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            Şu anda sistemde kayıtlı bir <strong>Yönetici</strong> bulunmuyor. <a asp-action="CreateUser">Yeni Yönetici Ekle</a>.
        </div>
    }
</div>

@model Alfabe.Controllers.Admin.NotificationsController.CreateVm
@{
    ViewData["Title"] = "Yeni Bildirim";
}
<h2 class="mb-3">Yeni Bildirim</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Başlık</label>
        <input asp-for="Title" class="form-control" />
        <span class="text-danger" asp-validation-for="Title"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Mesaj</label>
        <textarea asp-for="Message" rows="4" class="form-control"></textarea>
        <span class="text-danger" asp-validation-for="Message"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Hedef Kitle</label>
        <select asp-for="Audience" class="form-select">
            <option value="Parents">Veliler</option>
            <option value="Teachers">Öğretmenler</option>
            <option value="Both">Veliler + Öğretmenler</option>
        </select>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Planlanan Başlangıç (opsiyonel)</label>
            <input asp-for="ScheduledAt" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Bitiş (opsiyonel)</label>
            <input asp-for="ExpiresAt" type="datetime-local" class="form-control" />
        </div>
        <div class="col-md-4 mb-3 form-check" style="padding-top: 2rem;">
            <input asp-for="PublishNow" class="form-check-input" type="checkbox" id="pubNow" />
            <label for="pubNow" class="form-check-label">Hemen yayınla</label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Geri</a>
        <button type="submit" class="btn btn-primary">Oluştur</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

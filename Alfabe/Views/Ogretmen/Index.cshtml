@model IEnumerable<Alfabe.Models.Ogretmen>

@{
    ViewData["Title"] = "Öğretmen Listesi";
}

<h1 class="mb-4">Öğretmen Listesi</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Yeni Öğretmen Ekle
    </a>
</p>

<div class="table-responsive rounded-3 overflow-hidden shadow-sm border">
    <table class="table table-striped align-middle m-0">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().Ad)</th>
                <th>@Html.DisplayNameFor(model => model.First().Soyad)</th>
                <th>@Html.DisplayNameFor(model => model.First().Telefon)</th>
                <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                <th style="width: 180px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Ad)</td>
                    <td>@Html.DisplayFor(modelItem => item.Soyad)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefon)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">
                            <i class="fas fa-edit"></i> Düzenle
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1">
                            <i class="fas fa-info-circle"></i> Detay
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash-alt"></i> Sil
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

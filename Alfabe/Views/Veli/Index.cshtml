@model IEnumerable<Alfabe.Models.Veli>

@{
    ViewData["Title"] = "Veli Listesi";
    string currentSort = ViewData["CurrentSort"] as string ?? "";
    string currentSearch = ViewData["SearchTerm"] as string ?? "";
    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
    int totalPages = ViewData["TotalPages"] as int? ?? 1;
    int pageWindow = 2;
}

<h1 class="mb-4">Veli Listesi</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<form method="get" class="row g-3 align-items-center mb-3">
    <div class="col-auto">
        <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="Ad veya Soyada göre ara..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-search"></i> Ara
        </button>
    </div>
    <div class="col-auto">
        <a href="@Url.Action("Index", "Veli")" class="btn btn-secondary">
            <i class="fas fa-times"></i> Temizle
        </a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle"></i> Yeni Veli Ekle
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz kayıtlı veli bulunmamaktadır.</div>
}
else
{
    <div class="table-responsive rounded-3 overflow-hidden shadow-sm border">
        <table class="table table-striped table-hover align-middle m-0">
            <thead class="table-light">
                <tr>
                    <th>
                        @Html.ActionLink("Ad", "Index", new { sort = currentSort == "ad" ? "ad_desc" : "ad", search = currentSearch, page = currentPage })
                        @Html.Raw(currentSort == "ad" ? "<i class='fas fa-sort-up ms-1'></i>" : currentSort == "ad_desc" ? "<i class='fas fa-sort-down ms-1'></i>" : "")
                    </th>
                    <th>
                        @Html.ActionLink("Soyad", "Index", new { sort = currentSort == "soyad" ? "soyad_desc" : "soyad", search = currentSearch, page = currentPage })
                        @Html.Raw(currentSort == "soyad" ? "<i class='fas fa-sort-up ms-1'></i>" : currentSort == "soyad_desc" ? "<i class='fas fa-sort-down ms-1'></i>" : "")
                    </th>
                    <th>Telefon</th>
                    <th>Telefon2</th>
                    <th>Adres</th>  <!-- Yeni sütun eklendi -->
                    <th style="width: 180px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Ad</td>
                        <td>@item.Soyad</td>
                        <td>@item.Telefon</td>
                        <td>@item.Telefon2</td>
                        <td>@(item.Adres != null && !string.IsNullOrWhiteSpace(item.Adres.DetayAdres) ? item.Adres.DetayAdres : "Adres yok")</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Düzenle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1" title="Detaylar">
                                <i class="fas fa-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Sil">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

        <nav aria-label="Sayfalama">
            <ul class="pagination justify-content-center mt-3">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-sort="@currentSort" asp-route-search="@currentSearch" tabindex="-1">Önceki</a>
                </li>

                <li class="page-item @(currentPage == 1 ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-sort="@currentSort" asp-route-search="@currentSearch">1</a>
                </li>

                @if (currentPage - pageWindow > 2)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @for (int i = Math.Max(2, currentPage - pageWindow); i < currentPage; i++)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-sort="@currentSort" asp-route-search="@currentSearch">@i</a>
                    </li>
                }

                @if (currentPage != 1 && currentPage != totalPages)
                {
                    <li class="page-item active">
                        <span class="page-link">@currentPage</span>
                    </li>
                }

                @for (int i = currentPage + 1; i <= Math.Min(totalPages - 1, currentPage + pageWindow); i++)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-sort="@currentSort" asp-route-search="@currentSearch">@i</a>
                    </li>
                }

                @if (currentPage + pageWindow < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                }

                @if (totalPages > 1)
                {
                    <li class="page-item @(currentPage == totalPages ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@totalPages" asp-route-sort="@currentSort" asp-route-search="@currentSearch">@totalPages</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-sort="@currentSort" asp-route-search="@currentSearch">Sonraki</a>
                </li>
            </ul>
        </nav>
    </div>
}

@using Microsoft.AspNetCore.Identity
@using Alfabe.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Alfabe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- 🔹 Bootstrap CSS, FontAwesome, AdminLTE (LOCAL) -->
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.css" />
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css" />

    <!-- 🔹 Flatpickr CSS (LOCAL) -->
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" />

    <!-- 🔹 Proje CSS -->
    <link rel="stylesheet" href="~/css/site.css" />

    @RenderSection("Styles", required: false)
</head>

<body class="hold-transition layout-fixed @ViewData["BodyClass"]">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown">
                            <i class="fas fa-user-circle"></i> @User.Identity.Name
                        </a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin Paneli</a>
                            <div class="dropdown-divider"></div>
                            <form method="post" asp-controller="Account" asp-action="Logout" class="px-3">
                                <button type="submit" class="btn btn-link p-0 m-0 text-dark">Çıkış Yap</button>
                            </form>
                        </div>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="#" class="brand-link non-clickable-brand" tabindex="-1" aria-disabled="true" onclick="return false;">
                𝐀𝐥𝐟𝐚𝐛𝐞 𝐀𝐝𝐦𝐢𝐧
            </a>

            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(currentController == "Home" ? "active" : "")">
                                <i class="nav-icon fas fa-home"></i>
                                <p>Ana Sayfa</p>
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a asp-controller="Ogrenci" asp-action="Index" class="nav-link @(currentController == "Ogrenci" ? "active" : "")">
                                    <i class="nav-icon fas fa-user-graduate"></i>
                                    <p>Öğrenciler</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Veli" asp-action="Index" class="nav-link @(currentController == "Veli" ? "active" : "")">
                                    <i class="nav-icon fas fa-users"></i>
                                    <p>Veliler</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Ogretmen" asp-action="Index" class="nav-link @(currentController == "Ogretmen" ? "active" : "")">
                                    <i class="nav-icon fas fa-chalkboard-teacher"></i>
                                    <p>Öğretmenler</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Dersler" asp-action="Index" class="nav-link @(currentController == "Dersler" ? "active" : "")">
                                    <i class="nav-icon fas fa-book"></i>
                                    <p>Dersler</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Yoklama" asp-action="Index" class="nav-link @(currentController == "Yoklama" ? "active" : "")">
                                    <i class="nav-icon fas fa-clipboard-list"></i>
                                    <p>Yoklamalar</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Odeme" asp-action="Index" class="nav-link @(currentController == "Odeme" ? "active" : "")">
                                    <i class="nav-icon fas fa-credit-card"></i>
                                    <p>Ödemeler</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Admin" asp-action="Index" class="nav-link @(currentController == "Admin" ? "active" : "")">
                                    <i class="nav-icon fas fa-user-shield"></i>
                                    <p>Adminler</p>
                                </a>
                            </li>

                            <!-- Bildirimler -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                    <i class="bi bi-bell"></i> Bildirimler
                                </a>
                            </li>

                            <!-- 🔹 VBS Başvuruları -->
                            <li class="nav-header text-secondary mt-3">VBS Yönetimi</li>
                            <li class="nav-item">
                                <a asp-controller="VbsUsers" asp-action="Index" class="nav-link @(currentController == "VbsUsers" && currentAction == "Index" ? "active" : "")">
                                    <i class="nav-icon fas fa-user-clock"></i>
                                    <p>Bekleyen Başvurular</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="VbsUsers" asp-action="ApprovedList" class="nav-link @(currentController == "VbsUsers" && currentAction == "ApprovedList" ? "active" : "")">
                                    <i class="nav-icon fas fa-user-check"></i>
                                    <p>Onaylanan Başvurular</p>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a href="#" class="nav-link disabled text-muted">
                                    <i class="nav-icon fas fa-lock"></i>
                                    <p>Giriş Yapınız</p>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper p-3">
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer py-3 mt-4" style="background-color: #f8f9fa; font-size: 0.875rem; border-top: 1px solid #dee2e6;">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start">
                <div class="mb-2 mb-md-0">
                    <a href="/kvkk" class="text-secondary mx-2 text-decoration-none">KVKK</a> |
                    <a href="/gizlilik" class="text-secondary mx-2 text-decoration-none">Gizlilik Politikası</a>
                </div>

                <div class="mb-2 mb-md-0">
                    <strong>&copy; 2025 Alfabe Eğitim Gelişim ve Sanayi Ltd. Şti</strong>
                    <span class="text-muted"> - Tüm hakları saklıdır.</span>
                </div>

                <div class="text-secondary" style="font-weight: 500;">
                    Developed by <span style="font-weight:700;">Mehmet Enes YÖRÜK</span>
                </div>
            </div>
        </footer>

    </div>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/dist/js/adminlte.min.js"></script>

    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/lib/flatpickr/l10n/tr.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>

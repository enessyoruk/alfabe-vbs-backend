@model Alfabe.Models.Odeme

@{
    ViewData["Title"] = "Ödeme Detayları";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
        <h3 class="card-title m-0">Ödeme Detayları</h3>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Ödeme Tarihi</dt>
            <dd class="col-sm-9">@Model.OdemeTarihi.ToShortDateString()</dd>

            <dt class="col-sm-3">Tutar (₺)</dt>
            <dd class="col-sm-9">@Model.Tutar.ToString("N2")</dd>

            <dt class="col-sm-3">Ödendi Mi?</dt>
            <dd class="col-sm-9">@(Model.OdendiMi ? "Ödendi" : "Ödenmedi")</dd>

            <dt class="col-sm-3">Öğrenci</dt>
            <dd class="col-sm-9">
                @(Model.Ogrenci != null ? $"{Model.Ogrenci.Ad} {Model.Ogrenci.Soyad}" : "Bilinmiyor")
            </dd>

            <dt class="col-sm-3">Ödeme Tipi</dt>
            <dd class="col-sm-9">@Model.OdemeTipi</dd>

            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">@Model.Aciklama</dd>
        </dl>
    </div>
</div>

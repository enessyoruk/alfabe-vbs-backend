@model Alfabe.Models.Odeme

@{
    ViewData["Title"] = "Ödeme Silme Onayı";
}

<div class="card shadow-sm">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <h3 class="card-title m-0">Ödemeyi Sil</h3>
        <a asp-action="Index" class="btn btn-secondary ms-2">
            <i class="fas fa-arrow-left"></i> Geri Dön
        </a>

    </div>
    <div class="card-body">
        <h5>Bu ödeme kaydını silmek istediğinizden emin misiniz?</h5>
        <dl class="row">
            <dt class="col-sm-3">Ödeme Tarihi</dt>
            <dd class="col-sm-9">@Model.OdemeTarihi.ToShortDateString()</dd>

            <dt class="col-sm-3">Tutar (₺)</dt>
            <dd class="col-sm-9">@Model.Tutar.ToString("N2")</dd>

            <dt class="col-sm-3">Ödendi Mi?</dt>
            <dd class="col-sm-9">@(Model.OdendiMi ? "Ödendi" : "Ödenmedi")</dd>

            <dt class="col-sm-3">Öğrenci</dt>
            <dd class="col-sm-9">
                @(Model.Ogrenci != null ? $"{Model.Ogrenci.Ad} {Model.Ogrenci.Soyad}" : "Bilinmiyor")
            </dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash-alt"></i> Sil
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">
                <i class="fas fa-times"></i> İptal
            </a>
        </form>
    </div>
</div>

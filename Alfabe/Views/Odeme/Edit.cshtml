@model Alfabe.Models.Odeme

@{
    ViewData["Title"] = "Ödeme Düzenle";
}

<div class="card card-primary shadow-sm">
    <div class="card-header">
        <h3 class="card-title">Ödeme Düzenle</h3>
    </div>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="card-body">

            @* Başarı ve hata mesajları *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="OdemeTarihi" class="form-label">Ödeme Tarihi</label>
                <input asp-for="OdemeTarihi" class="form-control" type="date" />
                <span asp-validation-for="OdemeTarihi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Tutar" class="form-label">Tutar (₺)</label>
                <input asp-for="Tutar" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="Tutar" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="col-form-label pt-0">Ödeme Durumu</legend>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="OdendiMi" value="true" id="odendiEvet" />
                    <label class="form-check-label" for="odendiEvet">Ödendi</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="OdendiMi" value="false" id="odendiHayir" />
                    <label class="form-check-label" for="odendiHayir">Ödenmedi</label>
                </div>
                <span asp-validation-for="OdendiMi" class="text-danger d-block"></span>
            </fieldset>

            <div class="mb-3">
                <label asp-for="OgrenciId" class="form-label">Öğrenci</label>
                <select asp-for="OgrenciId" class="form-control" asp-items="@(ViewData["OgrenciId"] as SelectList)" disabled>
                    <option value="">-- Öğrenci Seçiniz --</option>
                </select>
                <span asp-validation-for="OgrenciId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OdemeTipi" class="form-label">Ödeme Tipi</label>
                <input asp-for="OdemeTipi" class="form-control" />
                <span asp-validation-for="OdemeTipi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label">Açıklama</label>
                <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between">
            <button type="submit" class="btn btn-success fw-bold shadow-sm">
                <i class="fas fa-save"></i> Kaydet
            </button>
            <a asp-action="Index" class="btn btn-dark fw-bold shadow-sm">
                <i class="fas fa-arrow-left"></i> Geri Dön
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

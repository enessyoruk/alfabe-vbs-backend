@model IEnumerable<Alfabe.Models.VbsUser>
@{
    ViewData["Title"] = "Onaylanan Başvurular";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-success"><i class="fas fa-user-shield"></i> Onaylanan Başvurular</h1>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle"></i> Henüz onaylanan başvuru bulunmuyor.
                    </div>
                }
                else
                {
                    <table class="table table-hover table-bordered table-striped align-middle">
                        <thead class="table-success">
                            <tr class="text-center">
                                <th>#</th>
                                <th>Ad Soyad</th>
                                <th>E-posta</th>
                                <th>Telefon</th>
                                <th>Tip</th>
                                <th>Onay Tarihi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr class="text-center">
                                    <td>@v.Id</td>
                                    <td>@v.FullName</td>
                                    <td>@v.Email</td>
                                    <td>@v.PhoneNumber</td>
                                    <td>
                                        @if (v.UserType == "parent")
                                        {
                                            <span class="badge bg-info">Veli</span>
                                        }
                                        else if (v.UserType == "teacher")
                                        {
                                            <span class="badge bg-secondary">Öğretmen</span>
                                        }
                                    </td>
                                    <td>@v.ApprovedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- Sayfalama -->
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center">
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ApprovedList", new { page = i })">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</section>

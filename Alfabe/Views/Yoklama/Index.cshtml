@model IEnumerable<Alfabe.Models.Yoklama>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Yoklama Listesi";

    string currentSearch = ViewData["SearchTerm"] as string ?? "";
    int? currentDevamDurumuId = ViewData["DevamDurumuId"] as int?;
    string tarihAraligi = ViewData["TarihAraligi"] as string ?? "";
    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
    int totalPages = ViewData["TotalPages"] as int? ?? 1;

    var devamDurumlari = ViewBag.DevamDurumlariListesi
        as SelectList ?? new SelectList(Enumerable.Empty<object>());
}

<section class="content-header mb-3">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1>
                    <i class="fas fa-calendar-check me-2"></i> @ViewData["Title"]
                </h1>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" class="btn btn-primary me-3">
                    <i class="fas fa-plus"></i> Yeni Yoklama Ekle
                </a>

                <!-- 🚨 YOKLAMALARI SIFIRLA (MODAL AÇAR) -->
                <button class="btn btn-danger"
                        data-toggle="modal"
                        data-target="#resetModal"
                        style="margin-left:30px;">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    Yoklamaları Sıfırla
                </button>

                <!-- ============================= -->
                <!--   🔥 RESET MODAL (Bootstrap4)  -->
                <!-- ============================= -->
                <div class="modal fade" id="resetModal" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content">

                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Yoklamaları Sıfırla
                                </h5>
                                <button type="button"
                                        class="close"
                                        data-dismiss="modal"
                                        aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                <p class="fw-bold text-danger mb-3">
                                    Bu işlem tüm yoklamaları tamamen silecek ve geri alınamaz!
                                </p>

                                <p class="text-muted">
                                    Yeni akademik yıla başlarken lütfen önce
                                    <strong>“Yoklamaları Sıfırla”</strong> butonuna basın.
                                    Bu işlem bir önceki yıla ait tüm yoklamaları siler
                                    ve sistemi yeni dönem için hazırlar.
                                </p>
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-secondary"
                                        data-dismiss="modal">
                                    Hayır, Vazgeç
                                </button>

                                <form method="post" asp-action="ResetAll" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger">
                                        Evet, Tüm Yoklamaları Sil
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="content mb-4">
    <div class="container-fluid">

        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="fas fa-check-circle me-2"></i> @message
                <button type="button"
                        class="close"
                        data-dismiss="alert"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- Filtre Formu -->
        <form method="get" class="row g-3 mb-3 align-items-center shadow-sm p-3 bg-white rounded">
            <div class="col-md-3">
                <input type="text" name="search" value="@currentSearch" class="form-control"
                       placeholder="Öğrenci adı veya soyadı..." />
            </div>

            <div class="col-md-3">
                <select name="devamDurumuId" class="form-select">
                    <option value="">-- Devam Durumu --</option>
                    @foreach (var durum in devamDurumlari)
                    {
                        <option value="@durum.Value"
                                selected="@(durum.Value == (currentDevamDurumuId?.ToString() ?? ""))">
                            @durum.Text
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <input type="text" id="tarihAraligi" name="tarihAraligi"
                       value="@tarihAraligi"
                       class="form-control"
                       placeholder="Tarih Aralığı Seçin" autocomplete="off" />
            </div>

            <div class="col-md-2 d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> Filtrele
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Temizle</a>
            </div>
        </form>

        <!-- Tablolu Liste -->
        @if (!Model.Any())
        {
            <div class="alert alert-info shadow-sm">
                <i class="fas fa-info-circle me-2"></i> Henüz yoklama kaydı bulunmamaktadır.
            </div>
        }
        else
        {
            <div class="table-responsive shadow-sm rounded border">
                <table class="table table-striped table-hover m-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th>Öğrenci Adı</th>
                            <th>Öğrenci Soyadı</th>
                            <th>Durum</th>
                            <th style="width:180px;" class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Tarih.ToString("dd.MM.yyyy")</td>
                                <td>@item.Ogrenci.Ad</td>
                                <td>@item.Ogrenci.Soyad</td>
                                <td>@item.DevamDurumu.DurumAdi</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm me-1" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm me-1" title="Detay">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm"
                                       title="Sil"
                                       onclick="return confirm('Bu yoklamayı silmek istediğinize emin misiniz?');">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sayfalama -->
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@currentSearch"
                           asp-route-devamDurumuId="@currentDevamDurumuId"
                           asp-route-tarihAraligi="@tarihAraligi">
                            Önceki
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@currentSearch"
                               asp-route-devamDurumuId="@currentDevamDurumuId"
                               asp-route-tarihAraligi="@tarihAraligi">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@currentSearch"
                           asp-route-devamDurumuId="@currentDevamDurumuId"
                           asp-route-tarihAraligi="@tarihAraligi">
                            Sonraki
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.flatpickr) {
                if (window.flatpickr.l10ns && window.flatpickr.l10ns.tr) {
                    flatpickr.localize(flatpickr.l10ns.tr);
                }

                flatpickr("#tarihAraligi", {
                    mode: "range",
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d.m.Y",
                    allowInput: true,
                    rangeSeparator: " - "
                });
            }
        });
    </script>
}

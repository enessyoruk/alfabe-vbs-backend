@model Alfabe.Models.ViewModels.YoklamaViewModel
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var devamList = (ViewBag.DevamDurumlariListesi as List<SelectListItem>)
                    .Select(x => new { value = x.Value, text = x.Text })
                    .ToList();

    var devamJson = JsonSerializer.Serialize(devamList);
}

<form asp-action="Create" method="post" autocomplete="off">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <!-- Tarih -->
    <div class="form-group mb-3">
        <label asp-for="Tarih" class="form-label"></label>
        <input asp-for="Tarih" class="form-control" type="date" value="@Model.Tarih.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Tarih" class="text-danger"></span>
    </div>

    <!-- Sınıf -->
    <div class="form-group mb-3">
        <label for="SinifSelect">Sınıf Seçin</label>
        <select id="SinifSelect" name="Sinif" class="form-control">
            <option value="" disabled selected>Lütfen Sınıf Seçin</option>

            @foreach (var sinif in (List<SelectListItem>)ViewBag.Siniflar)
            {
                <option value="@sinif.Value" selected="@(Model.Sinif.ToString() == sinif.Value ? "selected" : null)">
                    @sinif.Text
                </option>
            }
        </select>
        <span asp-validation-for="Sinif" class="text-danger"></span>
    </div>

    <!-- Öğrenciler -->
    <div class="form-group mb-3" id="ogrenciListContainer" style="display:none;">
        <label>Öğrenciler</label>
        <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
            <table class="table table-hover table-sm" id="ogrenciTable">
                <thead class="table-light">
                    <tr>
                        <th>Ad Soyad</th>
                        <th style="width:180px">Devam Durumu</th>
                    </tr>
                </thead>
                <tbody id="ogrenciTableBody">
                    <tr><td colspan="2" class="text-center text-muted">Önce sınıf seçin</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Kaydet & Geri Butonları -->
    <div class="form-group mt-3">
        <input type="submit" value="Kaydet" class="btn btn-primary" id="kaydetBtn" disabled />
        <a asp-action="Index" class="btn btn-secondary ms-2">Geri</a>
    </div>

    <!-- Kaydet ALTINDA BAŞARI MESAJI -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const devamDurumlari = @Html.Raw(devamJson);

        $(function () {

            $('#SinifSelect').on('change', function () {
                const sinif = $(this).val();

                $('#ogrenciTableBody').html('');
                $('#kaydetBtn').prop('disabled', true);

                if (!sinif) {
                    $('#ogrenciListContainer').hide();
                    return;
                }

                $('#ogrenciListContainer').show();
                $('#ogrenciTableBody').html('<tr><td colspan="2" class="text-center">Yükleniyor...</td></tr>');

                $.ajax({
                    url: '@Url.Action("GetOgrencilerBySinif", "Yoklama")',
                    type: 'GET',
                    data: { sinif: sinif },

                    success: function (data) {
                        $('#ogrenciTableBody').empty();

                        if (!data || !data.length) {
                            $('#ogrenciTableBody').append('<tr><td colspan="2" class="text-center text-muted">Öğrenci bulunamadı.</td></tr>');
                            return;
                        }

                        $.each(data, function (i, ogrenci) {

                            let optionsHtml = '';
                            devamDurumlari.forEach(dd => {
                                optionsHtml += `<option value="${dd.value}">${dd.text}</option>`;
                            });

                            $('#ogrenciTableBody').append(
                                `<tr>
                                    <td>${ogrenci.adSoyad}</td>
                                    <td>
                                        <select class="form-select devam-dropdown"
                                                name="OgrenciSecimleri[${i}].DevamDurumuId" required>
                                            ${optionsHtml}
                                        </select>

                                        <input type="hidden"
                                               name="OgrenciSecimleri[${i}].OgrenciId"
                                               value="${ogrenci.id}" />
                                    </td>
                                </tr>`
                            );
                        });

                        $('#kaydetBtn').prop('disabled', false);
                    },

                    error: function () {
                        $('#ogrenciTableBody').html('<tr><td colspan="2" class="text-center text-danger">Öğrenciler yüklenirken hata oluştu.</td></tr>');
                    }
                });
            });
        });
    </script>
}

@model Alfabe.Models.Yoklama

@{
    ViewData["Title"] = "Yoklama Detayları";
}

<section class="content-header mb-4">
    <h1>
        <i class="fas fa-info-circle me-2"></i>@ViewData["Title"]
    </h1>
</section>

<section class="content">
    <div class="card shadow-sm">

        <div class="card-header bg-info text-white">
            <h3 class="card-title">
                <i class="fas fa-list me-2"></i>Yoklama Bilgileri
            </h3>
        </div>

        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-3">Tarih</dt>
                <dd class="col-sm-9">@Model.Tarih.ToString("dd.MM.yyyy")</dd>

                <dt class="col-sm-3">Öğrenci</dt>
                <dd class="col-sm-9">@Model.Ogrenci?.Ad @Model.Ogrenci?.Soyad</dd>

                <dt class="col-sm-3">Devam Durumu</dt>
                <dd class="col-sm-9">@Model.DevamDurumu?.DurumAdi</dd>

            </dl>
        </div>

        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Düzenle
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Listeye Dön
            </a>
        </div>

    </div>
</section>

@model Alfabe.Models.Yoklama

@{
    ViewData["Title"] = "Yoklama Sil";
}

<h1 class="mb-4 text-danger">Yoklama Sil</h1>

<div class="alert alert-warning" role="alert">
    <strong>Dikkat!</strong>
    Bu yoklamayı silmek üzeresiniz. Bu işlem geri alınamaz.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-4">Yoklama Bilgileri</h5>

        <dl class="row">
            <dt class="col-sm-3">Tarih</dt>
            <dd class="col-sm-9">@Model.Tarih.ToString("dd.MM.yyyy")</dd>

            <dt class="col-sm-3">Öğrenci</dt>
            <dd class="col-sm-9">@Model.Ogrenci?.Ad @Model.Ogrenci?.Soyad</dd>

            <dt class="col-sm-3">Devam Durumu</dt>
            <dd class="col-sm-9">@Model.DevamDurumu?.DurumAdi</dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger me-2">
                <i class="fas fa-trash-alt"></i> Evet, Sil
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> İptal
            </a>
        </form>
    </div>
</div>

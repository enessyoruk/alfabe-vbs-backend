@model Alfabe.Models.Ogrenci

<div class="form-group">
    <label asp-for="Ad" class="control-label">Ad</label>
    <input asp-for="Ad" class="form-control" placeholder="Öğrencinin adını giriniz" />
    <span asp-validation-for="Ad" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Soyad" class="control-label">Soyad</label>
    <input asp-for="Soyad" class="form-control" placeholder="Öğrencinin soyadını giriniz" />
    <span asp-validation-for="Soyad" class="text-danger"></span>
</div>
<div class="form-group">
    <label class="control-label">Sınıf</label>
    <div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Sinif" value="5" id="sinif5" />
            <label class="form-check-label" for="sinif5">5. Sınıf</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Sinif" value="6" id="sinif6" />
            <label class="form-check-label" for="sinif6">6. Sınıf</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Sinif" value="7" id="sinif7" />
            <label class="form-check-label" for="sinif7">7. Sınıf</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Sinif" value="8" id="sinif8" />
            <label class="form-check-label" for="sinif8">8. Sınıf</label>
        </div>
    </div>
    <span asp-validation-for="Sinif" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Telefon" class="control-label"></label>
    <input asp-for="Telefon" class="form-control" placeholder="05xx xxx xx xx" maxlength="11" />
    <span asp-validation-for="Telefon" class="text-danger"></span>
</div>


<div class="form-group">
    <label class="control-label">Veli Seçiniz</label>
    <select asp-for="VeliId" class="form-control" asp-items="@(ViewData["VeliId"] as IEnumerable<SelectListItem>)">
        <option value="">Lütfen Veli Seçiniz</option>
    </select>
    <span asp-validation-for="VeliId" class="text-danger"></span>
</div>


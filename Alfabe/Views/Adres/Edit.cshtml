@model Alfabe.Models.Adres

@{
    ViewData["Title"] = "Adres Düzenle";
}

<h1>Adres Düzenle</h1>

<h4>Adres</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="DetayAdres" class="control-label"></label>
                <input asp-for="DetayAdres" class="form-control" />
                <span asp-validation-for="DetayAdres" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Kaydet" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Geri</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model Alfabe.Models.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alfabe - Giriş Yap</title>

    <!-- Bootstrap 4 CSS (LOCAL) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.css" />

    <style>
        body {
            margin: 0;
            padding: 0;
            background: url('/img/logo-alfabe.png') no-repeat center center fixed;
            background-size: contain;
            backdrop-filter: blur(6px);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f4f4f4;
        }

        .login-card {
            background-color: rgba(255, 255, 255, 0.85);
            border-radius: 15px;
            padding: 40px 30px;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.3);
            z-index: 2;
            animation: slideUp 0.8s ease;
        }

        @@keyframes slideUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #6c63ff;
        }

        .btn-login {
            background-color: #6c63ff;
            color: white;
            border: none;
        }

            .btn-login:hover {
                background-color: #574fd6;
            }
    </style>
</head>
<body>

    <div class="login-card text-center">
        <h3 class="mb-4">🔐 Giriş Yap</h3>

        <form asp-action="Login" method="post" autocomplete="off">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group text-start">
                <label asp-for="UserName">Kullanıcı Adı</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group text-start">
                <label asp-for="Password">Şifre</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check text-start mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Beni Hatırla</label>
            </div>

            <button type="submit" class="btn btn-login w-100">Giriş Yap</button>
        </form>
    </div>

    <!-- 🔹 jQuery mutlaka bootstrap'tan önce gelmeli -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- 🔹 Bootstrap 4 JS -->
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
